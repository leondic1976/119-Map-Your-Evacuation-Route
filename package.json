{
  "name": "home-escape-map",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "우리집 대피지도 — 초등학생용 재난안전 학습 웹 앱. 집을 블록으로 만들고 대피할 길을 그린 뒤, 불이 난 집에서 직접 빠져나와 본다",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "tsx tools/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tools/test.ts",
    "smoke": "tsx tools/smoke.ts",
    "build:standalone": "tsx tools/standalone.ts",
    "verify": "npm run typecheck && npm run validate && npm test && npm run build:standalone && npm run build && npm run smoke",
    "validate": "tsx tools/validate.ts",
    "validate:strict": "tsx tools/validate.ts --strict",
    "shots": "tsx tools/shots.ts",
    "voice": "tsx tools/voice-bake.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "lucide-react": "^1.37.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "^0.185.1",
    "three-pathfinding": "^1.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.3",
    "typescript": "5.7.3"
  }
}
